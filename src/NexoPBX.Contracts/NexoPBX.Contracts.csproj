<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- google/api/*.proto under Protos/ are import-only: their C# types come from Google.Api.CommonProtos. -->
    <Protobuf Include="Protos/nexopbx/v1/*.proto" GrpcServices="Both" ProtoRoot="Protos" />
  </ItemGroup>
</Project>
